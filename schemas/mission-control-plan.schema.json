{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "companiesascode.mission_control.plan.v2",
  "title": "Mission Control v2 plan",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "dev_code",
    "title",
    "status",
    "owner",
    "priority",
    "priority_rank",
    "created_at",
    "updated_at",
    "context",
    "current_problem",
    "target_state",
    "scope",
    "acceptance_criteria",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "companiesascode.mission_control.plan.v2" },
    "id": { "type": "string", "pattern": "^mcplan-[a-z]{2,6}-[0-9]{4}$" },
    "dev_code": { "type": "string", "pattern": "^[A-Z]{2,6}-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["shaping", "ready", "in_progress", "review", "blocked", "done", "archived"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["urgent", "high", "medium", "low"] },
    "priority_rank": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "context": { "type": "string", "minLength": 1 },
    "current_problem": { "type": "string", "minLength": 1 },
    "target_state": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "out": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "implementation_validation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "decision"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "github": {
      "type": "object",
      "properties": {
        "branches": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "status": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "todo_outputs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" }
    },
    "planning_target": {
      "type": "object",
      "required": ["scope", "todo_tasks_path"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "todo_tasks_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|/)TODO\\.tasks\\.json$"
        }
      },
      "additionalProperties": false
    },
    "proposed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["urgent", "high", "medium", "low"] },
          "priority_rank": { "type": "integer", "minimum": 1 },
          "assignee": { "type": "string", "minLength": 1 },
          "priority_decider": { "type": "string", "minLength": 1 },
          "priority_reason": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blocked_by": {
            "type": "array",
            "items": { "type": "string", "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "legacy_sources": {
      "type": "object",
      "properties": {
        "clickup": {
          "type": "object",
          "required": ["task_id", "custom_id", "url"],
          "properties": {
            "task_id": { "type": "string", "minLength": 1 },
            "custom_id": { "type": "string", "pattern": "^[A-Z]{2,6}-[0-9]{4}$" },
            "url": { "type": "string", "minLength": 1 },
            "status": { "type": "string" },
            "snapshot_path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "external_task": {
          "type": "object",
          "required": ["system", "id", "url"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "status": { "type": "string" },
            "snapshot_path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "import_review": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schema_fit": { "type": "string" },
        "schema_changes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "incident_addendum": {
      "type": "object",
      "required": ["reported_at", "reporter", "authorization", "observed_state"],
      "properties": {
        "reported_at": { "type": "string", "minLength": 1 },
        "reporter": { "type": "string", "minLength": 1 },
        "authorization": { "type": "string", "minLength": 1 },
        "observed_state": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "reviewer", "verdict", "evidence"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "reviewer": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

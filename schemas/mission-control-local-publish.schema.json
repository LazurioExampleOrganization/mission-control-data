{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companiesascode.local/schemas/mission-control-local-publish.schema.json",
  "title": "Mission Control local Principal publish evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "writer_mode",
    "requested_at",
    "base_commit",
    "changed_paths",
    "draft_revision",
    "validation_contract",
    "principal_id",
    "actor_id",
    "provider_access_audit"
  ],
  "properties": {
    "schema_version": {
      "const": "companiesascode.mission_control.local_publish.v1"
    },
    "writer_mode": {
      "const": "local-principal-v1"
    },
    "requested_at": {
      "$ref": "#/$defs/canonicalInstant"
    },
    "base_commit": {
      "$ref": "#/$defs/gitObject"
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "draft_revision": {
      "$ref": "#/$defs/sha256"
    },
    "validation_contract": {
      "const": "mission-control-data-validator.v1"
    },
    "principal_id": {
      "$ref": "#/$defs/concreteString"
    },
    "actor_id": {
      "$ref": "#/$defs/concreteString"
    },
    "provider_access_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_at",
        "checked_by"
      ],
      "properties": {
        "checked_at": {
          "$ref": "#/$defs/canonicalInstant"
        },
        "checked_by": {
          "$ref": "#/$defs/concreteString"
        }
      }
    }
  },
  "$defs": {
    "concreteString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!REPLACE_WITH_)(?!.*[\\u0000-\\u001f\\u007f])\\S(?:.*\\S)?$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^data/mission-control/(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f*?\\[\\]{}]+$"
    }
  }
}

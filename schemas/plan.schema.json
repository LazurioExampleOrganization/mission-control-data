{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "companiesascode.mission_control.plan.v2",
  "title": "Mission Control plan",
  "$comment": "Generated from the Zod schemas of Mission Control (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "companiesascode.mission_control.plan.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^mcplan-[a-z]{2,6}-[0-9]{4}$"
    },
    "dev_code": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "shaping",
        "ready",
        "in_progress",
        "review",
        "blocked",
        "done",
        "archived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ]
    },
    "priority_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "current_problem": {
      "type": "string",
      "minLength": 1
    },
    "target_state": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "todo_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
      }
    },
    "planning_target": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "todo_tasks_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\/)TODO\\.tasks\\.json$"
        }
      },
      "required": [
        "scope",
        "todo_tasks_path"
      ],
      "additionalProperties": false
    },
    "proposed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low"
            ]
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "assignee": {
            "type": "string",
            "minLength": 1
          },
          "priority_decider": {
            "type": "string",
            "minLength": 1
          },
          "priority_reason": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
            }
          }
        },
        "required": [
          "title",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "legacy_sources": {
      "type": "object",
      "properties": {
        "clickup": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "custom_id": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}-[0-9]{4}$"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string"
            },
            "snapshot_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "task_id",
            "custom_id",
            "url"
          ],
          "additionalProperties": false
        },
        "external_task": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string"
            },
            "snapshot_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "system",
            "id",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "import_review": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_fit": {
          "type": "string"
        },
        "schema_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "incident_addendum": {
      "type": "object",
      "properties": {
        "reported_at": {
          "type": "string",
          "minLength": 1
        },
        "reporter": {
          "type": "string",
          "minLength": 1
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        },
        "observed_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reported_at",
        "reporter",
        "authorization",
        "observed_state"
      ],
      "additionalProperties": false
    },
    "review_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "reviewer",
          "verdict",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "dev_code",
    "title",
    "status",
    "owner",
    "priority",
    "priority_rank",
    "created_at",
    "updated_at",
    "context",
    "current_problem",
    "target_state",
    "scope",
    "acceptance_criteria",
    "validation"
  ],
  "additionalProperties": false
}

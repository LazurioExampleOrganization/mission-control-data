{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "companiesascode.mission_control.roadmap.v1",
  "title": "Mission Control roadmap",
  "$comment": "Generated from the Zod schemas of Mission Control (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "companiesascode.mission_control.roadmap.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^mcroadmap-rm-[0-9]{4}$"
    },
    "roadmap_code": {
      "type": "string",
      "pattern": "^RM-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "shaping",
        "ready",
        "in_progress",
        "review",
        "blocked",
        "done",
        "archived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_plan": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}-[0-9]{4}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "main": {
      "type": "boolean"
    },
    "agent_lane": {
      "type": "object",
      "properties": {
        "reviewers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_agents": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewers",
        "execution_agents",
        "escalation_policy"
      ],
      "additionalProperties": false
    },
    "priorities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^priority-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "rank"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "shaping",
              "ready",
              "in_progress",
              "review",
              "blocked",
              "done",
              "archived"
            ]
          },
          "executable": {
            "type": "boolean"
          },
          "timing": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2]|Q[1-4])$"
              },
              "to": {
                "type": "string",
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2]|Q[1-4])$"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "committed",
                  "likely",
                  "tentative"
                ]
              }
            },
            "required": [
              "to"
            ],
            "additionalProperties": false
          },
          "priority_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^priority-[0-9]{3}$"
            }
          },
          "plan_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}-[0-9]{4}$"
            }
          },
          "todo_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
            }
          },
          "issue_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^issue-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          },
          "evidence_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "decision",
                        "doc",
                        "plan",
                        "pull_request",
                        "commit",
                        "report",
                        "validation",
                        "external"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "label",
                    "kind",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "decision",
                        "doc",
                        "plan",
                        "pull_request",
                        "commit",
                        "report",
                        "validation",
                        "external"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^https?:\\/\\/"
                    },
                    "verification": {
                      "type": "string",
                      "const": "external"
                    }
                  },
                  "required": [
                    "label",
                    "kind",
                    "url",
                    "verification"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "executable"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "roadmap_code",
    "title",
    "status",
    "owner",
    "priority",
    "created_at",
    "updated_at",
    "source_plan",
    "summary",
    "priorities",
    "steps"
  ],
  "additionalProperties": false
}
